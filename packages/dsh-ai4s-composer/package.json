{
  "name": "dsh-ai4s-composer",
  "version": "1.2.0",
  "type": "module",
  "description": "全自动 AI4S 模式：为 DSH 提供 quick / solo / delegate / cluster 四种编排模式，自动派发只读子代理并把结论回灌主代理；附带文档读取工具。",
  "homepage": "https://github.com/SESZFY/DSH-Plugin_Better-Wishing/tree/main/packages/dsh-ai4s-composer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SESZFY/DSH-Plugin_Better-Wishing.git",
    "directory": "packages/dsh-ai4s-composer"
  },
  "bugs": {
    "url": "https://github.com/SESZFY/DSH-Plugin_Better-Wishing/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ai4s",
    "subagents",
    "orchestration"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "dsh-ai4s-mode": "scripts/set-mode.mjs",
    "dsh-ai4s-menu": "scripts/install-model-menu.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "license": "MIT",
  "files": [
    "index.js",
    "document-reader.js",
    "document_reader.py",
    "document-requirements.txt",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "scripts/set-mode.mjs",
    "scripts/install-model-menu.mjs",
    "scripts/model-menu-edits.json",
    "scripts/LICENSE.deepseek",
    "README.md",
    "LICENSE"
  ]
}
